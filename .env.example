# Public HTTPS URL of the admin UI. SvelteKit checks form submissions against it (CSRF).
ORIGIN=https://tidepool.example.com

# argon2id hash printed by `npm run hash-password`.
# Keep the single quotes: Docker Compose expands every unquoted `$`.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$REPLACE$ME'

# Secret for signing session cookies, at least 32 characters: `openssl rand -base64 48`
SESSION_SECRET=

DATABASE_PATH=/data/tidepool.db

# Behind Pangolin's Traefik, read the client IP (used by the login rate limit) from X-Forwarded-For.
# See README "Pangolin".
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
